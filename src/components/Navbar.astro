---
/**
 * Sticky top bar: name, section anchors, and the printable CV/portfolio PDF.
 * Kept to one hairline-ruled strip — the title block below carries identity.
 */
import { siteInfo, navLinks } from '../data/projects';
---

<header class="sticky top-0 z-50 border-b border-edge bg-surface/95 backdrop-blur-sm">
  <nav class="mx-auto flex h-14 max-w-7xl items-center justify-between gap-4 px-4 sm:px-8">
    <a href="#top" class="font-mono text-xs font-medium tracking-widest text-ink uppercase">
      S.&thinsp;Hudínek
    </a>

    <ul class="hidden items-center gap-8 font-mono text-xs uppercase tracking-widest text-dim md:flex">
      {navLinks.map((link) => (
        <li>
          <a href={link.href} class="transition-colors hover:text-accent">{link.label}</a>
        </li>
      ))}
    </ul>

    <a
      href={siteInfo.cvPdf}
      download
      class="border border-edge px-3 py-1.5 font-mono text-xs uppercase tracking-widest text-ink transition-colors hover:border-accent hover:text-accent"
    >
      CV / PDF ↓
    </a>
  </nav>
</header>
