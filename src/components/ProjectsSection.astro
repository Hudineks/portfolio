---
/**
 * Project records: full-width hairline-divided rows, one per project.
 * Left column = index code, title, role, tags. Right column = STAR grid —
 * except on a record with demoSummary, where the summary paragraph replaces
 * the STAR grid / tag chips and the project's embedded live demo panel
 * (demoComponents lookup below) spans the full row beneath.
 * Driven entirely by src/data/projects.ts.
 */
import { projects } from '../data/projects';
import WaterMpcDemo from './WaterMpcDemo.astro';
import CvsHumidityDemo from './CvsHumidityDemo.astro';
import ScrDosingDemo from './ScrDosingDemo.astro';

const demoComponents: Record<string, any> = {
  'P-01': CvsHumidityDemo,
  'P-02': ScrDosingDemo,
  'P-03': WaterMpcDemo,
};

const starRows = [
  { key: 'situation', label: 'Situation' },
  { key: 'task', label: 'Task' },
  { key: 'action', label: 'Action' },
  { key: 'result', label: 'Result' },
] as const;
---

<section id="projects" class="border-b border-edge">
  <div class="mx-auto max-w-7xl px-4 pt-16 sm:px-8">
    <h2 class="font-mono text-xs uppercase tracking-widest text-accent">Projects</h2>
    <p class="mt-2 font-display text-3xl font-bold uppercase tracking-tight text-ink sm:text-4xl">
      Engineering Records
    </p>
  </div>

  <div class="mx-auto max-w-7xl divide-y divide-edge px-4 sm:px-8">
    {projects.map((project) => {
      const Demo = project.demoSummary ? demoComponents[project.id] : undefined;
      return (
      <article class="py-14">
        <div class="grid gap-8 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:gap-14">
          <!-- Meta column -->
          <div>
            <p class="font-mono text-xs tracking-widest text-dim">{project.id}</p>
            <h3 class="mt-2 font-display text-2xl font-bold uppercase leading-tight tracking-tight text-ink sm:text-3xl">
              {project.title}
            </h3>
            <p class="mt-2 font-mono text-xs uppercase tracking-widest text-accent">{project.role}</p>
            <p class="mt-4 max-w-md leading-relaxed text-dim">{project.tagline}</p>

            {!project.demoSummary && (
              <ul class="mt-6 flex flex-wrap gap-2">
                {project.tags.map((tag) => (
                  <li class="border border-edge px-2.5 py-1 font-mono text-xs text-dim">{tag}</li>
                ))}
              </ul>
            )}

            {project.demoHref && (
              <a
                href={project.demoHref}
                class="mt-6 inline-block font-mono text-xs uppercase tracking-widest text-accent hover:underline"
              >
                Interactive demo →
              </a>
            )}
          </div>

          {project.demoSummary ? (
            <p class="text-sm leading-relaxed text-ink/85 lg:self-center">{project.demoSummary}</p>
          ) : (
            <dl class="grid gap-px overflow-hidden border border-edge bg-edge sm:grid-cols-2">
              {starRows.map(({ key, label }) => (
                <div class="bg-panel p-5 sm:p-6">
                  <dt class="font-mono text-xs uppercase tracking-widest text-dim">{label}</dt>
                  <dd class="mt-2 text-sm leading-relaxed text-ink/85">{project.star[key]}</dd>
                </div>
              ))}
            </dl>
          )}
        </div>

        {Demo && (
          <div class="mt-10">
            <Demo />
          </div>
        )}
      </article>
      );
    })}
  </div>
</section>
