---
/**
 * About + contact, driven by siteInfo in src/data/projects.ts.
 */
import { siteInfo } from '../data/projects';

const { contact } = siteInfo;

const links = [
  { label: 'Email', value: contact.email, href: `mailto:${contact.email}` },
  { label: 'LinkedIn', value: 'in/simon-hudinek', href: contact.linkedin },
  { label: 'GitHub', value: 'Hudineks', href: contact.github },
];
---

<section id="about">
  <div class="mx-auto max-w-7xl px-4 pt-16 pb-20 sm:px-8">
    <h2 class="font-mono text-xs uppercase tracking-widest text-accent">Contact</h2>
    <p class="mt-2 font-display text-3xl font-bold uppercase tracking-tight text-ink sm:text-4xl">
      About & Contact
    </p>

    <div class="mt-10 grid gap-12 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
      <p class="max-w-2xl text-base leading-relaxed text-dim sm:text-lg">{siteInfo.bio}</p>

      <ul class="divide-y divide-edge border-y border-edge font-mono text-sm">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              target={link.href.startsWith('mailto') ? undefined : '_blank'}
              rel={link.href.startsWith('mailto') ? undefined : 'noopener noreferrer'}
              class="group flex items-baseline justify-between gap-4 py-3.5 transition-colors hover:text-accent"
            >
              <span class="text-xs uppercase tracking-widest text-dim group-hover:text-accent">{link.label}</span>
              <span class="text-ink group-hover:text-accent">{link.value}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <footer class="border-t border-edge py-5 text-center font-mono text-xs tracking-widest text-dim">
    © {new Date().getFullYear()} {siteInfo.name} — Astro + Tailwind
  </footer>
</section>
