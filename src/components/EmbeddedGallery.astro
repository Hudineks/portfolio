---
/**
 * Embedded & Smart Systems photo gallery: three clickable project photos.
 * Clicking a card opens an enlarged post-style overlay (image + story),
 * closable via the × button, backdrop click, or Escape.
 * Driven by embeddedStories in src/data/projects.ts.
 */
import { embeddedStories } from '../data/projects';
---

<div class="grid gap-px border border-edge bg-edge sm:grid-cols-3">
  {embeddedStories.map((s) => (
    <button
      type="button"
      class="story-open group bg-panel text-left"
      data-caption={s.caption}
      data-title={s.title}
      data-image={s.image}
      data-story={s.story}
      aria-haspopup="dialog"
    >
      <div class="aspect-[4/3] overflow-hidden">
        <img
          src={s.image}
          alt={s.title}
          loading="lazy"
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.04]"
        />
      </div>
      <div class="p-4 sm:p-5">
        <p class="font-mono text-xs uppercase tracking-widest text-accent">{s.caption}</p>
        <p class="mt-1 font-display text-lg font-bold uppercase leading-tight tracking-tight text-ink">
          {s.title}
        </p>
        <p class="mt-2 font-mono text-[10px] uppercase tracking-widest text-dim transition-colors group-hover:text-accent">
          Open the story →
        </p>
      </div>
    </button>
  ))}
</div>

<!-- Enlarged post overlay (shared by all three cards) -->
<div
  id="story-lightbox"
  class="fixed inset-0 z-[100] hidden items-center justify-center p-4 sm:p-8"
  role="dialog"
  aria-modal="true"
  aria-labelledby="story-lightbox-title"
>
  <div class="story-close absolute inset-0 bg-black/80 backdrop-blur-sm"></div>

  <figure class="relative z-10 flex max-h-full w-full max-w-2xl flex-col overflow-hidden border border-edge bg-panel shadow-2xl">
    <div class="flex items-start justify-between gap-4 border-b border-edge px-5 py-4">
      <div>
        <p id="story-lightbox-caption" class="font-mono text-xs uppercase tracking-widest text-accent"></p>
        <p id="story-lightbox-title" class="mt-1 font-display text-xl font-bold uppercase leading-tight tracking-tight text-ink"></p>
      </div>
      <button
        type="button"
        class="story-close -mr-1 -mt-1 shrink-0 border border-edge px-2.5 py-1 font-mono text-sm text-dim transition-colors hover:border-accent hover:text-accent"
        aria-label="Close story"
      >
        ✕
      </button>
    </div>

    <div class="min-h-0 overflow-y-auto">
      <img id="story-lightbox-image" src="" alt="" class="max-h-[55vh] w-full bg-surface object-contain" />
      <figcaption id="story-lightbox-story" class="px-5 py-5 text-sm leading-relaxed text-ink/85"></figcaption>
    </div>
  </figure>
</div>

<script>
  const lightbox = document.getElementById('story-lightbox')!;
  const caption = document.getElementById('story-lightbox-caption')!;
  const title = document.getElementById('story-lightbox-title')!;
  const image = document.getElementById('story-lightbox-image') as HTMLImageElement;
  const story = document.getElementById('story-lightbox-story')!;

  function open(btn: HTMLElement) {
    caption.textContent = btn.dataset.caption ?? '';
    title.textContent = btn.dataset.title ?? '';
    image.src = btn.dataset.image ?? '';
    image.alt = btn.dataset.title ?? '';
    story.textContent = btn.dataset.story ?? '';
    lightbox.classList.remove('hidden');
    lightbox.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }

  function close() {
    lightbox.classList.add('hidden');
    lightbox.classList.remove('flex');
    document.body.style.overflow = '';
  }

  document.querySelectorAll<HTMLElement>('.story-open').forEach((btn) => {
    btn.addEventListener('click', () => open(btn));
  });
  lightbox.querySelectorAll('.story-close').forEach((el) => {
    el.addEventListener('click', close);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !lightbox.classList.contains('hidden')) close();
  });
</script>
