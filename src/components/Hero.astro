---
/**
 * Title block: the compact identity strip that replaces a tall hero.
 * Modeled on an engineering drawing's title block: hairline-divided cells
 * for name, discipline, status, and revision info. A portrait sits to the
 * right of the name, fading into the graphite ground at its edges.
 */
import { siteInfo } from '../data/projects';
---

<section id="top" class="relative overflow-hidden border-b border-edge">
  <div class="relative mx-auto max-w-7xl px-4 py-12 sm:px-8 sm:py-16">
    <img src={siteInfo.portrait} alt={`Portrait of ${siteInfo.name}`} class="hero-portrait" />

    <div class="relative z-10 max-w-3xl">
      <h1 class="font-display text-4xl font-bold uppercase leading-none tracking-tight text-ink sm:text-6xl">
        {siteInfo.name}
      </h1>
      <p class="mt-3 max-w-xl text-base leading-relaxed text-dim sm:text-lg lg:max-w-3xl">
        {siteInfo.heroSubtitle}
      </p>
      <p class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs uppercase tracking-widest text-dim">
        <span>Open to</span>
        {siteInfo.openTo.map((role, i) => (
          <>
            {i > 0 && <span aria-hidden="true" class="text-edge">/</span>}
            <span class="text-ink">{role}</span>
          </>
        ))}
      </p>
    </div>
  </div>

  <!-- Title-block cells: discipline / status / origin / document -->
  <div class="relative z-10 grid grid-cols-2 border-t border-edge bg-surface/80 font-mono text-xs backdrop-blur-[2px] md:grid-cols-4">
    <div class="border-b border-r border-edge px-4 py-3 sm:px-8 md:border-b-0">
      <p class="uppercase tracking-widest text-dim">Discipline</p>
      <p class="mt-1 text-ink">{siteInfo.title}</p>
    </div>
    <div class="border-b border-edge px-4 py-3 sm:px-8 md:border-b-0 md:border-r">
      <p class="uppercase tracking-widest text-dim">Status</p>
      <p class="mt-1 flex items-center gap-2 text-ink">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-accent"></span>
        {siteInfo.availability}
      </p>
    </div>
    <div class="border-r border-edge px-4 py-3 sm:px-8">
      <p class="uppercase tracking-widest text-dim">Location</p>
      <p class="mt-1 text-ink">{siteInfo.location}</p>
    </div>
    <div class="px-4 py-3 sm:px-8">
      <p class="uppercase tracking-widest text-dim">Document</p>
      <p class="mt-1 flex flex-wrap gap-x-4 gap-y-1">
        <a href={siteInfo.cvFile} download class="text-ink underline decoration-edge underline-offset-4 transition-colors hover:text-accent hover:decoration-accent">
          CV
        </a>
        <a href={siteInfo.cvPdf} download class="text-ink underline decoration-edge underline-offset-4 transition-colors hover:text-accent hover:decoration-accent">
          Portfolio PDF
        </a>
      </p>
    </div>
  </div>
</section>

<style>
  /* Portrait to the right of the name: sits in the background, edges
     dissolved into the graphite ground via a soft radial mask. */
  .hero-portrait {
    position: absolute;
    top: 50%;
    right: 0;
    transform: translateY(-46%);
    height: 135%;
    width: auto;
    max-width: none;
    object-fit: cover;
    opacity: 0.85;
    pointer-events: none;
    user-select: none;
    -webkit-mask-image: radial-gradient(
      ellipse 58% 52% at 50% 44%,
      rgba(0, 0, 0, 1) 38%,
      rgba(0, 0, 0, 0) 74%
    );
    mask-image: radial-gradient(
      ellipse 58% 52% at 50% 44%,
      rgba(0, 0, 0, 1) 38%,
      rgba(0, 0, 0, 0) 74%
    );
  }

  /* On small screens the portrait recedes further so text stays readable. */
  @media (max-width: 767px) {
    .hero-portrait {
      opacity: 0.3;
      right: -3rem;
    }
  }
</style>
