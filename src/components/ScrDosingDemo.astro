---
/**
 * Static demo panel for P-02, embedded inside its project record in
 * ProjectsSection (in place of the STAR grid).
 *
 * Concept (agreed with Šimon after two iterations): a static SCADA/HMI
 * screen in the same industrial dialect as his Vodarna operator panel
 * (dark #222, #555 borders, green tags); no player, no controls.
 *   1. Mimic diagram of the exhaust line: engine → sensors → AdBlue
 *      injector → SCR catalyst → outlet sensors, with the ASC (ammonia
 *      slip catalyst) drawn dashed/crossed-out; the thesis selling point:
 *      NMPC keeps slip < 1 ppm so the ASC is not required.
 *   2. Static trend figure (SVG paths precomputed from the benchmark CSVs
 *      by scratchpad gen_trend_paths.py → src/data/scrTrendPaths.json):
 *      outlet NOx + NH3 slip (log), with the NMPC's 8-minute prediction
 *      horizon drawn at the 50→75 % load step and the honest trade-off
 *      (off-design NOx breakthrough) annotated.
 * Numbers from src/data/web_smooth/data_src/bench_*.csv; do not oversell:
 * NMPC conv 92.3 % vs PID 95.0 %; NMPC slip ≤ 0.9 ppm vs PID 262 ppm.
 */
import trend from '../data/scrTrendPaths.json';
---

<div id="demo-scr">
  <div class="hmi">
    <!-- ================= Mimic diagram ================= -->
    <svg class="mimic" viewBox="0 10 860 222" role="img"
      aria-label="Process diagram of the SCR aftertreatment line: diesel generator, AdBlue injector, SCR catalyst, outlet sensors, and a crossed-out ammonia-slip catalyst that the NMPC dosing controller makes unnecessary."
      font-family="'Segoe UI', Tahoma, Arial, sans-serif">

      <!-- main exhaust pipe -->
      <path d="M110,118 H838" stroke="#6f6f6f" stroke-width="9" fill="none" />
      <polygon points="838,110 856,118 838,126" fill="#6f6f6f" />
      <polygon points="132,112 143,118 132,124" fill="#a0a0a0" />
      <polygon points="560,112 571,118 560,124" fill="#a0a0a0" />
      <text x="131" y="141" text-anchor="middle" font-size="8.5" fill="#9a9a9a">EXHAUST</text>
      <text x="828" y="141" text-anchor="middle" font-size="8.5" fill="#9a9a9a">TAILPIPE</text>

      <!-- engine -->
      <rect x="20" y="90" width="90" height="56" fill="#2c2c2c" stroke="#888" stroke-width="1.5" />
      <text x="65" y="113" text-anchor="middle" font-size="11" fill="#eee">DIESEL</text>
      <text x="65" y="127" text-anchor="middle" font-size="11" fill="#eee">GENERATOR</text>
      <text x="65" y="162" text-anchor="middle" font-size="9" fill="#9a9a9a">LOAD 10–100 %</text>

      <!-- inlet sensors: temperature above, NOx below -->
      <line x1="150" y1="94" x2="150" y2="114" stroke="#888" stroke-width="1.5" />
      <circle cx="150" cy="80" r="14" fill="#2c2c2c" stroke="#888" stroke-width="1.5" />
      <text x="150" y="84" text-anchor="middle" font-size="10" fill="#eee">TT</text>
      <text x="150" y="52" text-anchor="middle" font-size="10" fill="#00d455" font-family="Consolas, monospace">150–427 °C</text>

      <line x1="208" y1="122" x2="208" y2="142" stroke="#888" stroke-width="1.5" />
      <circle cx="208" cy="156" r="14" fill="#2c2c2c" stroke="#888" stroke-width="1.5" />
      <text x="208" y="154" text-anchor="middle" font-size="9" fill="#eee">QT</text>
      <text x="208" y="164" text-anchor="middle" font-size="8" fill="#bbb">NOx</text>
      <text x="208" y="190" text-anchor="middle" font-size="10" fill="#00d455" font-family="Consolas, monospace">≤ 2734 ppm</text>

      <!-- AdBlue tank, dosing valve, injector -->
      <rect x="250" y="14" width="64" height="42" fill="#2c2c2c" stroke="#888" stroke-width="1.5" />
      <text x="282" y="32" text-anchor="middle" font-size="10" fill="#eee">ADBLUE</text>
      <text x="282" y="45" text-anchor="middle" font-size="8" fill="#bbb">TANK</text>
      <line x1="282" y1="56" x2="282" y2="76" stroke="#ccc" stroke-width="1.5" />
      <polygon points="272,76 292,76 282,86" fill="#2c2c2c" stroke="#ccc" stroke-width="1.2" />
      <polygon points="272,96 292,96 282,86" fill="#2c2c2c" stroke="#ccc" stroke-width="1.2" />
      <line x1="282" y1="96" x2="282" y2="110" stroke="#ccc" stroke-width="1.5" />
      <polygon points="276,110 288,110 282,119" fill="#00aaff" />

      <!-- SCR catalyst (monolith hatching) -->
      <rect x="370" y="90" width="175" height="56" fill="#2c2c2c" stroke="#999" stroke-width="2" />
      {Array.from({ length: 14 }, (_, i) => (
        <line x1={380 + i * 12} y1="92" x2={380 + i * 12} y2="144" stroke="#4a4a4a" stroke-width="1" />
      ))}
      <text x="457" y="115" text-anchor="middle" font-size="12" font-weight="700" fill="#fff"
        paint-order="stroke" stroke="#2c2c2c" stroke-width="4">SCR CATALYST</text>
      <text x="457" y="131" text-anchor="middle" font-size="9" fill="#ccc"
        paint-order="stroke" stroke="#2c2c2c" stroke-width="3">Fe-ZSM5 monolith</text>

      <!-- outlet sensors: NOx above, NH3 below -->
      <line x1="585" y1="94" x2="585" y2="114" stroke="#888" stroke-width="1.5" />
      <circle cx="585" cy="80" r="14" fill="#2c2c2c" stroke="#888" stroke-width="1.5" />
      <text x="585" y="78" text-anchor="middle" font-size="9" fill="#eee">QT</text>
      <text x="585" y="88" text-anchor="middle" font-size="8" fill="#bbb">NOx</text>
      <text x="585" y="52" text-anchor="middle" font-size="10" fill="#00d455" font-family="Consolas, monospace">conv 92.3 %</text>

      <line x1="635" y1="122" x2="635" y2="142" stroke="#888" stroke-width="1.5" />
      <circle cx="635" cy="156" r="14" fill="#2c2c2c" stroke="#888" stroke-width="1.5" />
      <text x="635" y="154" text-anchor="middle" font-size="9" fill="#eee">QT</text>
      <text x="635" y="164" text-anchor="middle" font-size="8" fill="#bbb">NH3</text>
      <text x="635" y="190" text-anchor="middle" font-size="10" fill="#00d455" font-family="Consolas, monospace">≤ 0.9 ppm</text>

      <!-- ASC: not needed with NMPC dosing -->
      <rect x="690" y="90" width="105" height="56" fill="none" stroke="#777" stroke-width="1.5" stroke-dasharray="5 4" />
      <line x1="690" y1="90" x2="795" y2="146" stroke="#666" stroke-width="1" />
      <line x1="690" y1="146" x2="795" y2="90" stroke="#666" stroke-width="1" />
      <text x="742" y="122" text-anchor="middle" font-size="13" fill="#888">ASC</text>
      <text x="742" y="76" text-anchor="middle" font-size="8.5" fill="#d99a1c">with PID: 262 ppm slip → mandatory</text>
      <text x="742" y="162" text-anchor="middle" font-size="9" fill="#00d455">NOT REQUIRED: slip &lt; 1 ppm</text>

      <!-- NMPC controller -->
      <rect x="330" y="178" width="240" height="48" fill="#2c2c2c" stroke="#00aa32" stroke-width="1.5" />
      <text x="450" y="198" text-anchor="middle" font-size="11" font-weight="700" fill="#fff">NMPC DOSING CONTROLLER</text>
      <text x="450" y="214" text-anchor="middle" font-size="9" fill="#bbb">internal 1D SCR model · prediction horizon 8 min</text>

      <!-- measurement signals (dashed) into the controller -->
      <g stroke="#4aa3ff" stroke-width="1.2" stroke-dasharray="4 3" fill="none">
        <path d="M150,94 V170 H336 V178" />
        <path d="M208,170 V166" />
        <path d="M585,94 V170 H564 V178" />
        <path d="M635,170 V166 M635,170 H564" />
      </g>

      <!-- control output to the dosing valve -->
      <path d="M350,178 V140 H304 V86 H300" stroke="#00d455" stroke-width="1.5" fill="none" />
      <polygon points="302,82 302,90 294,86" fill="#00d455" />
      <text x="310" y="134" font-size="9" fill="#00d455" font-family="Consolas, monospace">u(t) urea</text>
    </svg>

    <!-- ================= Trend ================= -->
    <div class="trend">
      <div class="trend-title">
        <span>EXHAUST AFTERTREATMENT TREND: 420 MIN LOAD CYCLE (XMR BENCHMARK)</span>
        <span class="legend">
          <span class="chip"><i class="sw sw-pid"></i>PID</span>
          <span class="chip"><i class="sw sw-nmpc"></i>NMPC</span>
        </span>
      </div>
      <svg viewBox="0 4 860 258" role="img"
        aria-label="Benchmark trends: NOx conversion and NH3 slip over the 420-minute load cycle for PID and NMPC. The NMPC's 8-minute prediction horizon is marked at the 190-minute load step, where the PID slips 262 ppm of ammonia and the NMPC stays below 1 ppm; at 25 and 50 percent load the NMPC gives up some NOx conversion in exchange."
        font-family="'Segoe UI', Tahoma, Arial, sans-serif">

        <!-- shutdown shading -->
        <rect x="782" y="28" width="66" height="100" fill="#262019" />
        <rect x="782" y="152" width="66" height="90" fill="#262019" />

        <!-- generator load profile: faint step area in the background of
             panel A (0..100 % load mapped onto the full panel height) -->
        <polygon
          points="56,128 56,118 169,118 179,103 292,103 301,78 414,78 424,53 537,53 546,28 659,28 669,53 782,53 782,128"
          fill="#8f8e85" fill-opacity="0.12" stroke="#8f8e85" stroke-opacity="0.35" stroke-width="1" />
        <text x="50" y="22" text-anchor="end" font-size="9" fill="#8f8e85">LOAD</text>
        <text x="815" y="22" text-anchor="middle" font-size="9" fill="#8f8e85">STOP</text>

        <!-- stage boundaries -->
        <g stroke="#333" stroke-width="1" stroke-dasharray="2 5">
          <line x1="169" y1="28" x2="169" y2="242" />
          <line x1="179" y1="28" x2="179" y2="242" />
          <line x1="292" y1="28" x2="292" y2="242" />
          <line x1="301" y1="28" x2="301" y2="242" />
          <line x1="414" y1="28" x2="414" y2="242" />
          <line x1="424" y1="28" x2="424" y2="242" />
          <line x1="537" y1="28" x2="537" y2="242" />
          <line x1="546" y1="28" x2="546" y2="242" />
          <line x1="659" y1="28" x2="659" y2="242" />
          <line x1="669" y1="28" x2="669" y2="242" />
          <line x1="782" y1="28" x2="782" y2="242" />
        </g>

        <!-- panel A: NOx conversion, linear 60..100 % -->
        <g stroke="#2c2c2a" stroke-width="1">
          <line x1="56" y1="53" x2="848" y2="53" />
          <line x1="56" y1="78" x2="848" y2="78" />
          <line x1="56" y1="103" x2="848" y2="103" />
        </g>
        <g font-size="9" fill="#8f8e85" text-anchor="end">
          <text x="50" y="31">100</text>
          <text x="50" y="56">90</text>
          <text x="50" y="81">80</text>
          <text x="50" y="106">70</text>
          <text x="50" y="131">60</text>
        </g>
        <rect x="56" y="28" width="792" height="100" fill="none" stroke="#3a3a37" />
        <text x="815" y="82" text-anchor="middle" font-size="8.5" fill="#6f6e66">engine off</text>

        <!-- panel B: NH3 slip, log 0.01..1000 ppm -->
        <g stroke="#2c2c2a" stroke-width="1">
          <line x1="56" y1="170" x2="848" y2="170" />
          <line x1="56" y1="188" x2="848" y2="188" />
          <line x1="56" y1="206" x2="848" y2="206" />
          <line x1="56" y1="224" x2="848" y2="224" />
        </g>
        <g font-size="9" fill="#8f8e85" text-anchor="end">
          <text x="50" y="155">1000</text>
          <text x="50" y="173">100</text>
          <text x="50" y="191">10</text>
          <text x="50" y="209">1</text>
          <text x="50" y="227">0.1</text>
          <text x="50" y="245">0.01</text>
        </g>
        <rect x="56" y="152" width="792" height="90" fill="none" stroke="#3a3a37" />

        <!-- 10 ppm slip target -->
        <line x1="56" y1="188" x2="848" y2="188" stroke="#d99a1c" stroke-width="1" stroke-dasharray="6 4" opacity="0.7" />
        <text x="740" y="184" text-anchor="end" font-size="9" fill="#d99a1c">10 ppm slip target</text>

        <!-- NMPC prediction horizon at the 50→75 % load step -->
        <rect x="408.6" y="28" width="15.1" height="214" fill="#3987e5" opacity="0.14" />
        <line x1="408.6" y1="28" x2="408.6" y2="246" stroke="#4aa3ff" stroke-width="1" stroke-dasharray="3 3" />
        <circle cx="408.6" cy="14" r="7" fill="#1a1a1a" stroke="#4aa3ff" stroke-width="1.2" />
        <text x="408.6" y="17.5" text-anchor="middle" font-size="9" fill="#4aa3ff">1</text>

        <!-- curves -->
        <g fill="none" stroke-linejoin="round" stroke-linecap="round">
          <path d={trend.conv_pid} stroke="#e05a4a" stroke-width="1.7" />
          <path d={trend.conv_nmpc} stroke="#3987e5" stroke-width="1.7" />
          <path d={trend.nh3_pid} stroke="#e05a4a" stroke-width="1.7" />
          <path d={trend.nh3_nmpc} stroke="#3987e5" stroke-width="1.7" />
        </g>

        <!-- load-step percentages, centered inside each shaded column -->
        <g font-size="9" fill="#c7c6bc" text-anchor="middle" paint-order="stroke" stroke="#1a1a1a" stroke-width="3" stroke-linejoin="round">
          <text x="113" y="123">10 %</text>
          <text x="235" y="116">25 %</text>
          <text x="358" y="103">50 %</text>
          <text x="480" y="91">75 %</text>
          <text x="603" y="78">100 %</text>
          <text x="725" y="91">75 %</text>
        </g>

        <!-- panel titles (on top of the curves, with backing plates) -->
        <rect x="710" y="31" width="142" height="16" fill="#1a1a1a" opacity="0.88" />
        <text x="844" y="43" text-anchor="end" font-size="10" fill="#c3c2b7">NOx CONVERSION [%]</text>
        <rect x="718" y="154" width="134" height="16" fill="#1a1a1a" opacity="0.88" />
        <text x="844" y="166" text-anchor="end" font-size="10" fill="#c3c2b7">NH3 SLIP [ppm] · LOG</text>

        <!-- annotations -->
        <text x="440" y="160" font-size="10" fill="#e05a4a">PID: 262 ppm</text>
        <text x="630" y="200" text-anchor="middle" font-size="9.5" fill="#3987e5">NMPC ≤ 0.9 ppm across the cycle</text>
        <circle cx="266" cy="47" r="7" fill="#1a1a1a" stroke="#c3c2b7" stroke-width="1.2" />
        <text x="266" y="50.5" text-anchor="middle" font-size="9" fill="#c3c2b7">2</text>

        <!-- x axis -->
        <g font-size="9" fill="#8f8e85" text-anchor="middle">
          <text x="56" y="256">0</text>
          <text x="169" y="256">60</text>
          <text x="282" y="256">120</text>
          <text x="395" y="256">180</text>
          <text x="509" y="256">240</text>
          <text x="622" y="256">300</text>
          <text x="735" y="256">360</text>
        </g>
        <text x="852" y="256" text-anchor="end" font-size="9" fill="#8f8e85">420 min</text>
      </svg>
    </div>

    <div class="notes">
      <p><b class="m m-1">1</b> The NMPC previews <b>8 min ahead</b>: the load step at t = 190 min is already inside its horizon, so dosing tapers before it: no slip, no ASC. The PID reacts late: 262 ppm.</p>
      <p><b class="m m-2">2</b> The price: lower NOx conversion at low load (<b>still within emission limits</b>) in exchange for one catalyst less and less urea (92.3 % vs 95.0 % over the cycle, −6 % urea).</p>
    </div>
  </div>
</div>

<style>
  /* Fixed dark HMI, same industrial dialect as the Vodarna operator panel
     (WaterMpcDemo): #222 background, #2c2c2c panels, #555 borders, green
     status color. Deliberately does not follow the site light/dark theme. */
  #demo-scr {
    scroll-margin-top: 4.5rem;
    container-type: inline-size;
  }
  #demo-scr, #demo-scr * { box-sizing: border-box; }

  .hmi {
    background: #222;
    border: 1px solid #555;
    color: #eee;
    font-family: 'Segoe UI', Tahoma, Arial, sans-serif;
  }

  .mimic {
    display: block;
    width: 100%;
    height: auto;
    padding: 0.5rem 0.25rem 0;
  }

  .trend {
    margin: 0.75rem;
    background: #1a1a1a;
    border: 1px solid #555;
  }
  .trend-title {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.25rem 1rem;
    padding: 0.35rem 0.6rem;
    border-bottom: 1px solid #444;
    font-size: 11px;
    letter-spacing: 0.05em;
    color: #ccc;
  }
  .legend { display: inline-flex; gap: 0.9rem; }
  .chip { display: inline-flex; align-items: center; gap: 0.35rem; font-size: 11px; color: #ccc; }
  .sw { width: 14px; height: 3px; border-radius: 2px; display: inline-block; }
  .sw-pid { background: #e05a4a; }
  .sw-nmpc { background: #3987e5; }
  .trend svg { display: block; width: 100%; height: auto; }

  .notes {
    padding: 0.25rem 0.85rem 0.75rem;
    display: grid;
    gap: 0.45rem 1.5rem;
  }
  @container (min-width: 720px) {
    .notes { grid-template-columns: 1fr 1fr; }
  }
  .notes p {
    margin: 0;
    font-size: 0.8rem;
    line-height: 1.5;
    color: #bbb;
  }
  .notes b { color: #eee; }
  .m {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    width: 1.15rem;
    height: 1.15rem;
    border-radius: 50%;
    border: 1px solid;
    font-size: 0.7rem;
    margin-right: 0.25rem;
    vertical-align: -0.15rem;
  }
  .m-1 { color: #4aa3ff; border-color: #4aa3ff; }
  .m-2 { color: #c3c2b7; border-color: #c3c2b7; }
</style>
