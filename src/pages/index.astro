---
/**
 * Single-page portfolio: sections stacked in scroll order.
 * Section ids (#projects, #field, #stack, #about) must match navLinks
 * in src/data/projects.ts.
 */
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import InteractiveFieldGallery from '../components/InteractiveFieldGallery.astro';
import TechStack from '../components/TechStack.astro';
import AboutContact from '../components/AboutContact.astro';
---

<Layout>
  <Navbar />
  <main>
    <Hero />
    <ProjectsSection />
    <InteractiveFieldGallery />
    <TechStack />
    <AboutContact />
  </main>
</Layout>
